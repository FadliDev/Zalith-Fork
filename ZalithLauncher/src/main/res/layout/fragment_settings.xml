<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait: icon-only settings tabs with even hit targets. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.movtery.zalithlauncher.ui.fragment.SettingsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/settings_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.angcyo.tablayout.DslTabLayout
            android:id="@+id/settings_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background_menu_top"
            app:tab_item_is_equ_width="true"
            app:tab_draw_indicator="true"
            app:tab_indicator_style="STYLE_BOTTOM"
            app:tab_indicator_height="@dimen/_2sdp"
            app:tab_orientation="HORIZONTAL">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:minWidth="@dimen/_48sdp"
                android:paddingHorizontal="@dimen/_4sdp">

                <ImageView
                    android:id="@+id/video_image"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:contentDescription="@string/setting_category_video"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_ui_video" android:tint="@color/icon_color"
                    />

                
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:minWidth="@dimen/_48sdp"
                android:paddingHorizontal="@dimen/_4sdp">

                <ImageView
                    android:id="@+id/controls_image"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:contentDescription="@string/setting_category_control"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_ui_controls" android:tint="@color/icon_color"
                    />

                
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:minWidth="@dimen/_48sdp"
                android:paddingHorizontal="@dimen/_4sdp">

                <ImageView
                    android:id="@+id/game_image"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:contentDescription="@string/setting_category_game"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_ui_game" android:tint="@color/icon_color"
                    />

                
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:minWidth="@dimen/_48sdp"
                android:paddingHorizontal="@dimen/_4sdp">

                <ImageView
                    android:id="@+id/launcher_image"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:contentDescription="@string/setting_category_launcher"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_ui_launcher" android:tint="@color/icon_color"
                    />

                
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:minWidth="@dimen/_48sdp"
                android:paddingHorizontal="@dimen/_4sdp">

                <ImageView
                    android:id="@+id/experimental_image"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:contentDescription="@string/setting_category_experimental"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_ui_experimental" android:tint="@color/icon_color"
                    />

                
            </LinearLayout>

        </com.angcyo.tablayout.DslTabLayout>

        <View
            android:id="@+id/shadowView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/card_stroke"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/settings_viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/settings_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>
