<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:ignore="ContentDescription">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/classify_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_72sdp"
        android:background="@color/surface_raised"
        android:elevation="@dimen/_2sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.angcyo.tablayout.DslTabLayout
            android:id="@+id/classify_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface_raised"
            app:tab_item_is_equ_width="true"
            app:tab_draw_indicator="true"
            app:tab_indicator_style="STYLE_BOTTOM"
            app:tab_indicator_height="@dimen/_2sdp"
            app:tab_orientation="HORIZONTAL"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/mod_image"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/download_classify_mod"
                    app:srcCompat="@drawable/ic_ui_mods" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_26sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:lineSpacingExtra="0dp"
                    android:text="@string/download_classify_mod"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/modpack_image"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/download_classify_modpack"
                    app:srcCompat="@drawable/ic_ui_modpack" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_26sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:lineSpacingExtra="0dp"
                    android:text="@string/download_classify_modpack"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/resource_pack_image"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/download_classify_resource_pack"
                    app:srcCompat="@drawable/ic_ui_resource" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_26sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:lineSpacingExtra="0dp"
                    android:text="@string/download_classify_resource_pack"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/world_image"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/download_classify_world"
                    app:srcCompat="@drawable/ic_ui_world" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_26sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:lineSpacingExtra="0dp"
                    android:text="@string/download_classify_world"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/shader_pack_image"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/download_classify_shader_pack"
                    app:srcCompat="@drawable/ic_ui_shader" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_26sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:lineSpacingExtra="0dp"
                    android:text="@string/download_classify_shader_pack"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>
        </com.angcyo.tablayout.DslTabLayout>

        <View
            android:id="@+id/classify_shadowView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/card_stroke"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/download_viewpager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/classify_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>
